<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 312">
  <defs>
    <style>
      .flow { stroke-dasharray:10 5; animation: flow 1.6s linear infinite; }
      @keyframes flow { to { stroke-dashoffset: -45; } }
      .blink { animation: blink 1.1s step-end infinite; }
      @keyframes blink { 50%{opacity:0} }
    </style>
    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" fill="#4f46e5"/>
    </marker>
    <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="0.9" fill="#c7d2fe" opacity="0.7"/>
    </pattern>
  </defs>

  <rect width="520" height="312" fill="#f8f9ff"/>
  <rect width="520" height="312" fill="url(#dots)"/>
  <rect x="0" y="0" width="4" height="312" fill="#e11d48"/>

  <!-- Header -->
  <rect x="0" y="0" width="520" height="52" fill="#1e1b4b"/>
  <line x1="0" y1="52" x2="520" y2="52" stroke="#4f46e5" stroke-width="1.5"/>
  <text x="16" y="20" font-family="IBM Plex Mono,Courier New,monospace" font-size="7.5" fill="#a5b4fc" letter-spacing="2.5" font-weight="600">DEEP SIGNAL  ◈  GRID THE GREY</text>
  <text x="16" y="42" font-family="IBM Plex Mono,Courier New,monospace" font-size="12" fill="#ffffff" font-weight="700">{{ title|truncate(52, true, '…') }}</text>

  <!-- Terminal -->
  <rect x="16" y="62" width="220" height="130" rx="5" fill="#1e1b4b"/>
  <rect x="16" y="62" width="220" height="3" fill="#4f46e5"/>
  <rect x="16" y="65" width="220" height="22" fill="#2d2a5e"/>
  <circle cx="30" cy="76" r="4" fill="#ef4444"/>
  <circle cx="42" cy="76" r="4" fill="#f59e0b"/>
  <circle cx="54" cy="76" r="4" fill="#22c55e"/>
  <text x="126" y="80" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="#a5b4fc" text-anchor="middle" font-weight="600" letter-spacing="1">{{ terminal_title }}</text>
  <text x="26"  y="105" font-family="IBM Plex Mono,Courier New,monospace" font-size="8.5" fill="#4ade80" font-weight="700">$</text>
  <text x="36"  y="105" font-family="IBM Plex Mono,Courier New,monospace" font-size="8.5" fill="#e2e8f0">{{ cmd_line1 }}</text>
  <text x="36"  y="119" font-family="IBM Plex Mono,Courier New,monospace" font-size="8.5" fill="#e2e8f0">{{ cmd_line2 }}</text>
  <rect x="36"  y="124" width="6" height="10" fill="#818cf8" class="blink"/>

  <!-- Capability pills (4) -->
  {% set pill_colors = [('#312e81','#6366f1','#c7d2fe'),('#312e81','#6366f1','#c7d2fe'),('#1e3a5f','#38bdf8','#7dd3fc'),('#1e3a5f','#38bdf8','#7dd3fc')] %}
  {% for cap in capabilities[:4] %}
  {% set col = pill_colors[loop.index0] %}
  {% set px = 22 if loop.index0 % 2 == 0 else 122 %}
  {% set py = 141 + (loop.index0 // 2) * 24 %}
  <rect x="{{ px }}" y="{{ py }}" width="92" height="18" rx="9" fill="{{ col[0] }}" stroke="{{ col[1] }}" stroke-width="0.8"/>
  <text x="{{ px + 46 }}" y="{{ py + 12 }}" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="{{ col[2] }}" text-anchor="middle" font-weight="600">{{ cap }}</text>
  {% endfor %}

  <!-- Arrow -->
  <line x1="244" y1="127" x2="280" y2="127" stroke="#4f46e5" stroke-width="1.4" class="flow" marker-end="url(#arr)"/>

  <!-- Output boxes (2) -->
  {% for box in outputs[:2] %}
  <rect x="284" y="{{ 62 + loop.index0 * 68 }}" width="220" height="58" rx="5" fill="#ffffff" stroke="#059669" stroke-width="1.2"/>
  <rect x="500" y="{{ 62 + loop.index0 * 68 }}" width="4" height="58" rx="1" fill="#059669"/>
  <text x="296" y="{{ 82 + loop.index0 * 68 }}" font-family="IBM Plex Mono,Courier New,monospace" font-size="9" fill="#065f46" font-weight="700">{{ box.title }}</text>
  <text x="296" y="{{ 97 + loop.index0 * 68 }}" font-family="IBM Plex Mono,Courier New,monospace" font-size="7.5" fill="#6b7280">{{ box.subtitle }}</text>
  <text x="296" y="{{ 112 + loop.index0 * 68 }}" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="#9ca3af">{{ box.detail }}</text>
  {% endfor %}

  <!-- Warning strip -->
  <rect x="16" y="202" width="488" height="20" rx="3" fill="#fff1f2" stroke="#e11d48" stroke-width="0.8" stroke-dasharray="4 2"/>
  <text x="260" y="215" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="#e11d48" text-anchor="middle" font-weight="700">⚠  {{ warning }}</text>

  <!-- Framework badges (5) -->
  {% set badge_colors = [('#eff6ff','#3b82f6','#1d4ed8'),('#faf5ff','#a855f7','#7e22ce'),('#fff1f2','#e11d48','#9f1239'),('#fefce8','#d97706','#92400e'),('#f0fdf4','#059669','#065f46')] %}
  {% for badge in frameworks[:5] %}
  {% set bc = badge_colors[loop.index0] %}
  <rect x="{{ 16 + loop.index0 * 98 }}" y="230" width="88" height="18" rx="3" fill="{{ bc[0] }}" stroke="{{ bc[1] }}" stroke-width="0.8"/>
  <text x="{{ 60 + loop.index0 * 98 }}" y="242" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="{{ bc[2] }}" text-anchor="middle" font-weight="700">{{ badge }}</text>
  {% endfor %}

  <!-- Stats -->
  <line x1="16" y1="258" x2="504" y2="258" stroke="#e0e7ff" stroke-width="0.8"/>
  {% for stat in stats[:3] %}
  <text x="{{ 16 + loop.index0 * 160 }}" y="284" font-family="IBM Plex Mono,Courier New,monospace" font-size="18" fill="#1e1b4b" font-weight="700">{{ stat.value }}</text>
  <text x="{{ 50 + loop.index0 * 160 }}" y="279" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="#6b7280">{{ stat.label_top }}</text>
  <text x="{{ 50 + loop.index0 * 160 }}" y="290" font-family="IBM Plex Mono,Courier New,monospace" font-size="7" fill="#6b7280">{{ stat.label_bot }}</text>
  {% endfor %}

  <text x="504" y="302" font-family="IBM Plex Mono,Courier New,monospace" font-size="6.5" fill="#a5b4fc" text-anchor="end">gridthegrey.com</text>
  <polyline points="498,305 512,305 512,294" fill="none" stroke="#4f46e5" stroke-width="1" opacity="0.4"/>
  <polyline points="10,305 10,311 20,311"   fill="none" stroke="#4f46e5" stroke-width="1" opacity="0.4"/>
</svg>
