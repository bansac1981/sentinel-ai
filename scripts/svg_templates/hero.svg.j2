<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630">
  <defs>
    <style>
      /* Shared animations */
      @keyframes flow   { to { stroke-dashoffset: -60; } }
      @keyframes flow2  { to { stroke-dashoffset: -60; } }
      @keyframes pulse  { 0%,100%{opacity:1} 50%{opacity:0.4} }
      @keyframes rise   { 0%{transform:translateY(8px);opacity:0} 100%{transform:translateY(0);opacity:1} }
      @keyframes glow   { 0%,100%{filter:drop-shadow(0 0 6px #f97316)} 50%{filter:drop-shadow(0 0 18px #f97316)} }
      @keyframes glowB  { 0%,100%{filter:drop-shadow(0 0 6px #6366f1)} 50%{filter:drop-shadow(0 0 18px #6366f1)} }
      @keyframes spin   { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
      @keyframes orb    { 0%,100%{r:38} 50%{r:44} }
      .flow  { stroke-dasharray:14 8; animation:flow  1.6s linear infinite; }
      .flow2 { stroke-dasharray:14 8; animation:flow2 2.1s linear infinite; }
      .pulse { animation:pulse 2.4s ease-in-out infinite; }
      .rise  { animation:rise 0.7s ease-out both; }
      .glow-amber { animation:glow  2.2s ease-in-out infinite; }
      .glow-indigo { animation:glowB 2.8s ease-in-out infinite; }
    </style>

    <!-- Arrow markers -->
    <marker id="arr-red"    viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#ef4444"/></marker>
    <marker id="arr-amber"  viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#f97316"/></marker>
    <marker id="arr-indigo" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#6366f1"/></marker>
    <marker id="arr-teal"   viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#0d9488"/></marker>

    <!-- Filters -->
    <filter id="card-shadow" x="-8%" y="-8%" width="116%" height="116%">
      <feDropShadow dx="0" dy="3" stdDeviation="6" flood-color="#1e1b4b" flood-opacity="0.10"/>
    </filter>
    <filter id="node-glow-r" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#ef4444" flood-opacity="0.5"/>
    </filter>
    <filter id="node-glow-i" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#6366f1" flood-opacity="0.4"/>
    </filter>
    <filter id="node-glow-t" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#0d9488" flood-opacity="0.4"/>
    </filter>

    <!-- Subtle grid pattern -->
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e2e8f0" stroke-width="0.6"/>
    </pattern>

    <!-- Radial gradients for nodes -->
    <radialGradient id="grad-red" cx="40%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#fef2f2"/>
      <stop offset="100%" stop-color="#fee2e2"/>
    </radialGradient>
    <radialGradient id="grad-amber" cx="40%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#fffbeb"/>
      <stop offset="100%" stop-color="#fef3c7"/>
    </radialGradient>
    <radialGradient id="grad-indigo" cx="40%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#eef2ff"/>
      <stop offset="100%" stop-color="#e0e7ff"/>
    </radialGradient>
    <radialGradient id="grad-teal" cx="40%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#f0fdfa"/>
      <stop offset="100%" stop-color="#ccfbf1"/>
    </radialGradient>
  </defs>

  <!-- ── BACKGROUND ── -->
  <rect width="1200" height="630" fill="#f8fafc"/>
  <rect width="1200" height="630" fill="url(#grid)" opacity="0.7"/>

  <!-- Soft colour wash top-right -->
  <ellipse cx="1100" cy="80" rx="320" ry="180" fill="#eef2ff" opacity="0.55"/>
  <!-- Soft colour wash bottom-left -->
  <ellipse cx="120" cy="560" rx="260" ry="140" fill="#f0fdfa" opacity="0.6"/>

{% if article_type == "1" %}
  {# ════════════════════════════════════════════════════════════
     TYPE 1 — ATTACK CHAIN FLOW
     Five nodes across the canvas: Attacker → Entry → Pivot → Target → Impact
     ════════════════════════════════════════════════════════════ #}

  <!-- Section label -->
  <text x="600" y="118" font-family="Inter,Segoe UI,sans-serif" font-size="11" fill="#94a3b8" letter-spacing="4" text-anchor="middle" font-weight="600">ATTACK CHAIN ANALYSIS</text>

  <!-- ── NODE DEFINITIONS (5 nodes, evenly spaced) ── -->
  <!-- Node centres: x = 110, 310, 510, 710, 910, 1090 -->

  <!-- Node 1 — Attacker origin (red) -->
  <g filter="url(#node-glow-r)" class="glow-amber">
    <circle cx="140" cy="290" r="52" fill="url(#grad-red)" stroke="#ef4444" stroke-width="2.5"/>
  </g>
  <text x="140" y="281" font-family="Inter,Segoe UI,sans-serif" font-size="22" text-anchor="middle">⚠</text>
  <text x="140" y="301" font-family="Inter,Segoe UI,sans-serif" font-size="10.5" fill="#991b1b" font-weight="700" text-anchor="middle">THREAT</text>
  <text x="140" y="315" font-family="Inter,Segoe UI,sans-serif" font-size="10.5" fill="#991b1b" font-weight="700" text-anchor="middle">ORIGIN</text>

  <!-- Node 2 — Entry point (amber) -->
  <rect x="254" y="252" width="152" height="76" rx="14" fill="url(#grad-amber)" stroke="#f59e0b" stroke-width="2" filter="url(#card-shadow)"/>
  <text x="330" y="281" font-family="Inter,Segoe UI,sans-serif" font-size="18" text-anchor="middle">🔓</text>
  <text x="330" y="300" font-family="Inter,Segoe UI,sans-serif" font-size="10" fill="#92400e" font-weight="700" text-anchor="middle">{{ inputs[0].title if inputs else 'INITIAL ACCESS' }}</text>
  <text x="330" y="316" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="#b45309" text-anchor="middle">{{ inputs[0].subtitle|truncate(22,true,'…') if inputs else '' }}</text>

  <!-- Node 3 — Pivot / escalation (amber-red) -->
  <rect x="454" y="240" width="152" height="100" rx="14" fill="#fff7ed" stroke="#f97316" stroke-width="2.5" filter="url(#card-shadow)"/>
  <rect x="454" y="240" width="152" height="6" rx="7" fill="#f97316"/>
  <text x="530" y="272" font-family="Inter,Segoe UI,sans-serif" font-size="18" text-anchor="middle">⚡</text>
  <text x="530" y="292" font-family="Inter,Segoe UI,sans-serif" font-size="10" fill="#c2410c" font-weight="700" text-anchor="middle">{{ inputs[1].title if inputs|length > 1 else 'ESCALATION' }}</text>
  <text x="530" y="307" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="#ea580c" text-anchor="middle">{{ inputs[1].subtitle|truncate(22,true,'…') if inputs|length > 1 else '' }}</text>
  <text x="530" y="321" font-family="Inter,Segoe UI,sans-serif" font-size="7.5" fill="#9ca3af" text-anchor="middle">{{ inputs[1].detail|truncate(28,true,'…') if inputs|length > 1 else '' }}</text>

  <!-- Node 4 — Target (indigo) -->
  <rect x="654" y="252" width="152" height="76" rx="14" fill="url(#grad-indigo)" stroke="#6366f1" stroke-width="2" filter="url(#card-shadow)"/>
  <text x="730" y="281" font-family="Inter,Segoe UI,sans-serif" font-size="18" text-anchor="middle">🎯</text>
  <text x="730" y="300" font-family="Inter,Segoe UI,sans-serif" font-size="10" fill="#3730a3" font-weight="700" text-anchor="middle">{{ inputs[2].title if inputs|length > 2 else 'TARGET' }}</text>
  <text x="730" y="316" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="#4338ca" text-anchor="middle">{{ inputs[2].subtitle|truncate(22,true,'…') if inputs|length > 2 else '' }}</text>

  <!-- Node 5 — Impact (dark red, prominent) -->
  <rect x="854" y="235" width="172" height="110" rx="14" fill="#fef2f2" stroke="#dc2626" stroke-width="3" filter="url(#node-glow-r)"/>
  <rect x="854" y="235" width="172" height="7" rx="7" fill="#dc2626"/>
  <text x="940" y="270" font-family="Inter,Segoe UI,sans-serif" font-size="20" text-anchor="middle">💥</text>
  <text x="940" y="293" font-family="Inter,Segoe UI,sans-serif" font-size="11" fill="#7f1d1d" font-weight="800" text-anchor="middle">{{ outputs[0].title if outputs else 'IMPACT' }}</text>
  <text x="940" y="310" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="#991b1b" text-anchor="middle">{{ outputs[0].subtitle|truncate(24,true,'…') if outputs else '' }}</text>
  <text x="940" y="325" font-family="Inter,Segoe UI,sans-serif" font-size="7.5" fill="#b91c1c" text-anchor="middle">{{ outputs[0].detail|truncate(28,true,'…') if outputs else '' }}</text>

  <!-- ── ANIMATED FLOW LINES between nodes ── -->
  <line x1="194" y1="290" x2="252" y2="290" stroke="#ef4444" stroke-width="2" class="flow" marker-end="url(#arr-red)"/>
  <line x1="408" y1="290" x2="452" y2="290" stroke="#f97316" stroke-width="2" class="flow" marker-end="url(#arr-amber)"/>
  <line x1="608" y1="290" x2="652" y2="290" stroke="#f97316" stroke-width="2" class="flow" marker-end="url(#arr-amber)"/>
  <line x1="808" y1="290" x2="852" y2="290" stroke="#dc2626" stroke-width="2.5" class="flow" marker-end="url(#arr-red)"/>

  <!-- Step labels under connectors -->
  <text x="232" y="310" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#ef4444" text-anchor="middle" opacity="0.7">step 1</text>
  <text x="432" y="310" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#f97316" text-anchor="middle" opacity="0.7">step 2</text>
  <text x="632" y="310" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#f97316" text-anchor="middle" opacity="0.7">step 3</text>
  <text x="832" y="310" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#dc2626" text-anchor="middle" opacity="0.7">impact</text>

  <!-- ── MITIGATIONS row (below chain) ── -->
  <rect x="80" y="390" width="1040" height="64" rx="10" fill="#f0fdf4" stroke="#86efac" stroke-width="1.2" filter="url(#card-shadow)"/>
  <text x="110" y="416" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#166534" font-weight="700" letter-spacing="3">MITIGATIONS</text>
  {% for cap in capabilities[:4] %}
  <rect x="{{ 108 + loop.index0 * 248 }}" y="424" width="228" height="20" rx="10" fill="#dcfce7" stroke="#22c55e" stroke-width="1"/>
  <text x="{{ 222 + loop.index0 * 248 }}" y="438" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#15803d" text-anchor="middle" font-weight="600">{{ cap }}</text>
  {% endfor %}

{% else %}
  {# ════════════════════════════════════════════════════════════
     TYPE 2 — CAPABILITY MAP
     Concentric-zone diagram: outer ring = context/ecosystem,
     middle ring = capability layer, core = the technology itself
     ════════════════════════════════════════════════════════════ #}

  <!-- Section label -->
  <text x="600" y="118" font-family="Inter,Segoe UI,sans-serif" font-size="11" fill="#94a3b8" letter-spacing="4" text-anchor="middle" font-weight="600">CAPABILITY ARCHITECTURE</text>

  <!-- ── CONCENTRIC ZONES ── -->
  <!-- Outer zone — ecosystem context -->
  <circle cx="490" cy="308" r="190" fill="#f8fafc" stroke="#c7d2fe" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.9"/>
  <!-- Middle zone — capability layer -->
  <circle cx="490" cy="308" r="128" fill="#eef2ff" stroke="#a5b4fc" stroke-width="2" opacity="0.85"/>
  <!-- Core zone — the technology -->
  <circle cx="490" cy="308" r="62" fill="#e0e7ff" stroke="#6366f1" stroke-width="2.5" filter="url(#node-glow-i)" class="pulse"/>

  <!-- Zone labels -->
  <text x="490" y="138" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#94a3b8" text-anchor="middle" letter-spacing="2.5">ECOSYSTEM</text>
  <text x="490" y="200" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#6366f1" text-anchor="middle" letter-spacing="2.5">CAPABILITY LAYER</text>

  <!-- Core label -->
  <text x="490" y="301" font-family="Inter,Segoe UI,sans-serif" font-size="12" fill="#3730a3" font-weight="800" text-anchor="middle">{{ center_label|truncate(14,true,'…') }}</text>
  <text x="490" y="318" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#4338ca" text-anchor="middle">{{ mode_value }}</text>

  <!-- ── ORBITING CAPABILITY NODES (6, evenly around middle ring) ── -->
  <!-- Pre-computed positions: 6 nodes at r=128 from (490,308) at 300°,0°,60°,120°,180°,240° -->
  <!-- Spoke endpoints at r=92 (just inside middle ring) -->
  {% set node_cx = [554, 618, 554, 426, 362, 426] %}
  {% set node_cy = [197, 308, 419, 419, 308, 197] %}
  {% set spoke_x = [536, 582, 536, 444, 398, 444] %}
  {% set spoke_y = [228, 308, 388, 388, 308, 228] %}
  {% for cap in capabilities[:6] %}
  {% set cx = node_cx[loop.index0] %}
  {% set cy = node_cy[loop.index0] %}
  <line x1="490" y1="308" x2="{{ spoke_x[loop.index0] }}" y2="{{ spoke_y[loop.index0] }}" stroke="#a5b4fc" stroke-width="1" stroke-dasharray="4 3" opacity="0.6"/>
  <rect x="{{ cx - 56 }}" y="{{ cy - 14 }}" width="112" height="28" rx="14" fill="#ffffff" stroke="#6366f1" stroke-width="1.5" filter="url(#card-shadow)"/>
  <text x="{{ cx }}" y="{{ cy + 4 }}" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="#3730a3" text-anchor="middle" font-weight="600">{{ cap|truncate(18,true,'…') }}</text>
  {% endfor %}

  <!-- ── RIGHT PANEL — inputs/outputs as stacked info cards ── -->
  <text x="760" y="174" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#6366f1" font-weight="700" letter-spacing="3">INPUTS</text>
  {% for box in inputs[:2] %}
  <rect x="758" y="{{ 182 + loop.index0 * 68 }}" width="380" height="58" rx="10" fill="#ffffff" stroke="#e0e7ff" stroke-width="1.5" filter="url(#card-shadow)"/>
  <rect x="758" y="{{ 182 + loop.index0 * 68 }}" width="4" height="58" rx="2" fill="#6366f1"/>
  <text x="774" y="{{ 205 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="10.5" fill="#1e1b4b" font-weight="700">{{ box.title }}</text>
  <text x="774" y="{{ 222 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#64748b">{{ box.subtitle|truncate(42,true,'…') }}</text>
  <text x="774" y="{{ 233 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#94a3b8">{{ box.detail|truncate(48,true,'…') }}</text>
  {% endfor %}

  <text x="760" y="334" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#0d9488" font-weight="700" letter-spacing="3">OUTPUTS</text>
  {% for box in outputs[:2] %}
  <rect x="758" y="{{ 342 + loop.index0 * 68 }}" width="380" height="58" rx="10" fill="#ffffff" stroke="#ccfbf1" stroke-width="1.5" filter="url(#card-shadow)"/>
  <rect x="758" y="{{ 342 + loop.index0 * 68 }}" width="4" height="58" rx="2" fill="#0d9488"/>
  <text x="774" y="{{ 365 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="10.5" fill="#1e1b4b" font-weight="700">{{ box.title }}</text>
  <text x="774" y="{{ 382 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#64748b">{{ box.subtitle|truncate(42,true,'…') }}</text>
  <text x="774" y="{{ 393 + loop.index0 * 68 }}" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#94a3b8">{{ box.detail|truncate(48,true,'…') }}</text>
  {% endfor %}

  <!-- Connector arrows from diagram to cards -->
  <line x1="618" y1="260" x2="756" y2="220" stroke="#a5b4fc" stroke-width="1.2" stroke-dasharray="5 3" marker-end="url(#arr-indigo)" opacity="0.6"/>
  <line x1="618" y1="350" x2="756" y2="378" stroke="#5eead4" stroke-width="1.2" stroke-dasharray="5 3" marker-end="url(#arr-teal)" opacity="0.6"/>

{% endif %}

  <!-- ── HEADER BAR ── -->
  <rect x="0" y="0" width="1200" height="76" fill="#0f172a"/>
  <line x1="0" y1="76" x2="1200" y2="76" stroke="#6366f1" stroke-width="2.5"/>
  <!-- Accent strip -->
  <rect x="0" y="0" width="5" height="76" fill="#6366f1"/>
  <text x="24" y="26" font-family="Inter,Segoe UI,sans-serif" font-size="9.5" fill="#a5b4fc" letter-spacing="4" font-weight="600">DEEP SIGNAL  ◈  GRID THE GREY</text>
  <text x="24" y="58" font-family="Inter,Segoe UI,sans-serif" font-size="21" fill="#ffffff" font-weight="800" letter-spacing="0.2">{{ title|upper|truncate(70, false, '') }}</text>
  <text x="1176" y="30" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#475569" text-anchor="end">{{ date }}</text>
  <text x="1176" y="58" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#475569" text-anchor="end">gridthegrey.com</text>

  <!-- ── FOOTER BAR ── -->
  <rect x="0" y="498" width="1200" height="132" fill="#f1f5f9"/>
  <line x1="0" y1="498" x2="1200" y2="498" stroke="#e2e8f0" stroke-width="1.5"/>

  <!-- Framework badges -->
  <text x="40" y="522" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#64748b" font-weight="700" letter-spacing="3">FRAMEWORK COVERAGE</text>
  {% set badge_colors = [('#eff6ff','#3b82f6','#1d4ed8'),('#faf5ff','#a855f7','#7e22ce'),('#fff1f2','#e11d48','#9f1239'),('#fefce8','#d97706','#92400e'),('#fff7ed','#f97316','#c2410c'),('#f0fdf4','#059669','#065f46'),('#f0f9ff','#0ea5e9','#0369a1')] %}
  {% for badge in frameworks[:7] %}
  {% set bc = badge_colors[loop.index0] %}
  <rect x="{{ 40 + loop.index0 * 162 }}" y="530" width="150" height="26" rx="6" fill="{{ bc[0] }}" stroke="{{ bc[1] }}" stroke-width="1.2"/>
  <text x="{{ 115 + loop.index0 * 162 }}" y="547" font-family="Inter,Segoe UI,sans-serif" font-size="8.5" fill="{{ bc[2] }}" text-anchor="middle" font-weight="700">{{ badge }}</text>
  {% endfor %}

  <!-- Stats -->
  <line x1="40" y1="568" x2="1160" y2="568" stroke="#e2e8f0" stroke-width="1"/>
  {% for stat in stats[:3] %}
  <text x="{{ 40 + loop.index0 * 220 }}" y="602" font-family="Inter,Segoe UI,sans-serif" font-size="28" fill="#0f172a" font-weight="800">{{ stat.value }}</text>
  <text x="{{ 40 + loop.index0 * 220 + (stat.value|length) * 15 + 6 }}" y="596" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#64748b">{{ stat.label_top }}</text>
  <text x="{{ 40 + loop.index0 * 220 + (stat.value|length) * 15 + 6 }}" y="609" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#64748b">{{ stat.label_bot }}</text>
  {% endfor %}

  {% if warning_stat %}
  <rect x="700" y="578" width="260" height="34" rx="6" fill="#fff1f2" stroke="#e11d48" stroke-width="1.2"/>
  <text x="830" y="592" font-family="Inter,Segoe UI,sans-serif" font-size="9" fill="#e11d48" text-anchor="middle" font-weight="700">{{ warning_stat.line1 }}</text>
  <text x="830" y="607" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#9f1239" text-anchor="middle">{{ warning_stat.line2 }}</text>
  {% endif %}

  <text x="1160" y="622" font-family="Inter,Segoe UI,sans-serif" font-size="8" fill="#94a3b8" text-anchor="end">gridthegrey.com/deep-signal/{{ slug }}/</text>
</svg>
